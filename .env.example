# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only — never expose to the client
ANTHROPIC_API_KEY=                # server only — attendance parsing + column mapping
NEXT_PUBLIC_APP_URL=              # e.g. http://localhost:3000, for links in notifications

# REQUIRED. Protects the daily birthday cron route (/api/cron/birthdays).
# The route refuses to run without it — it used to fail open, so with this
# unset anyone could spam the welfare team and suppress the real run.
# Vercel Cron sends this automatically as `Authorization: Bearer <secret>`.
CRON_SECRET=

# Optional. Set to "true" once your Supabase project has working SMTP, so new
# self-signups must confirm their email address before they can sign in.
# Left unset, accounts are created pre-confirmed (no mail is sent), which means
# someone can register under another person's email address.
REQUIRE_EMAIL_CONFIRMATION=
